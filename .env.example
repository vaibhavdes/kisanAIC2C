# Copy to .env.local (git-ignored) and fill in what you need. Every value here is optional
# for local development; defaults are in services/api/src/kisanai_c2c/settings.py.

APP_ENV=development
NODE_ID=india-node-mh
DEFAULT_LOCALE=en-IN

# Storage: sqlite (local file) or firestore; media: local folder or gcs bucket
STORE_PROVIDER=sqlite
SQLITE_PATH=work/kisanai.sqlite3
MEDIA_PROVIDER=local
MEDIA_DIRECTORY=work/media
# FIRESTORE_DATABASE=
# MEDIA_BUCKET=

# Google Cloud: Gemini on Vertex AI, Earth Engine and Speech use this project
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-south1
AI_PROVIDER=vertex
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=            # only with AI_PROVIDER=gemini_api
EARTH_ENGINE_ENABLED=true
SPEECH_ENABLED=true

# Weather
OPEN_METEO_ENABLED=true
IMD_ENABLED=false            # needs IMD API access below
# IMD_API_KEY=
# IMD_EMAIL=
# IMD_PASSWORD=

# Expert review (Plant Doctor cases). Leave unset to keep it open; when set, the expert screen asks for this code.
# EXPERT_ACCESS_CODE=
