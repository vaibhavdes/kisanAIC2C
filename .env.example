# Copy to .env.local (git-ignored) and fill in. Every variable maps to a field in
# services/api/src/kisanai_c2c/settings.py; anything left out uses the default there.

APP_ENV=development

# --- Node identity (one node per state or group of states) ---------------------------------
NODE_ID=india-node-mh
NODE_COUNTRY_CODE=IN
NODE_LABEL=Maharashtra and Uttar Pradesh node
# ISO 3166-2 codes whose bundled agronomy packs this node publishes and uses.
NODE_SUBDIVISIONS=IN-MH,IN-UP
# Public URL of this node, used in its /.well-known/agrin-node manifest.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Comma-separated peer node URLs this node may import packs and practices from (allowlist).
PEER_NODES=

# --- Access ---------------------------------------------------------------------------------
AUTH_MODE=local
# Code that officers type to open the expert workspace. Leave empty only for local development.
EXPERT_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage: sqlite + local media for development; firestore + gcs for production ----------
STORE_PROVIDER=sqlite
SQLITE_PATH=work/kisanai-c2c.sqlite3
FIRESTORE_DATABASE=kisanai-c2c
MEDIA_PROVIDER=local
MEDIA_DIRECTORY=work/media
MEDIA_BUCKET=

# --- Google Cloud AI ------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
AI_ENABLED=true
AI_PROVIDER=vertex
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_LOCATION=global
# Only for AI_PROVIDER=gemini_api
GEMINI_API_KEY=

# --- Evidence providers ---------------------------------------------------------------------
OPEN_METEO_ENABLED=true
EARTH_ENGINE_ENABLED=true
SPEECH_ENABLED=true
IMD_ENABLED=true
IMD_BASE_URL=https://api.imd.gov.in
IMD_AUTH_MODE=jwt
IMD_EMAIL=
IMD_PASSWORD=
