{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kisanai-c2c:practice-bundle:1.0.0",
  "title": "KISANAI C2C reviewed practice bundle",
  "description": "Privacy-minimised exchange contract for agronomist-reviewed practices. It contains no farmer identity or field geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "practice_version", "vocabulary_version", "origin", "created_at", "data_mode", "license", "title", "summary", "applicability", "steps", "contraindications", "evidence", "origin_review"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^practice_[a-f0-9]{32}$"},
    "practice_version": {"type": "integer", "minimum": 1},
    "vocabulary_version": {"const": "c2c-1"},
    "origin": {"type": "object", "additionalProperties": false, "required": ["node_id", "country_code", "organization_label"], "properties": {
      "node_id": {"type": "string", "minLength": 2, "maxLength": 80},
      "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
      "organization_label": {"type": "string", "minLength": 1, "maxLength": 120}
    }},
    "created_at": {"type": "string", "format": "date-time"},
    "data_mode": {"const": "curated"},
    "license": {"enum": ["CC0-1.0", "CC-BY-4.0"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "summary": {"type": "string", "minLength": 10, "maxLength": 1200},
    "applicability": {"type": "object", "additionalProperties": false, "required": ["country_codes", "state_codes", "crops", "seasons", "water_contexts"], "properties": {
      "country_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
      "state_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 20}},
      "crops": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 80}},
      "seasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["kharif", "rabi", "summer"]}},
      "water_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["rainfed", "supplemental_irrigation", "irrigated"]}}
    }},
    "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["instruction"], "properties": {"instruction": {"type": "string", "minLength": 1, "maxLength": 600}}}},
    "contraindications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["citation_url"], "properties": {"citation_url": {"type": "string", "format": "uri", "pattern": "^https://"}}}},
    "origin_review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer_subject", "reviewed_at"], "properties": {
      "status": {"const": "reviewed"},
      "reviewer_subject": {"type": "string", "minLength": 1, "maxLength": 200},
      "reviewed_at": {"type": "string", "format": "date-time"}
    }}
  }
}
