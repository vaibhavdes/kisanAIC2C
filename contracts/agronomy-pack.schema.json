{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kisanai-c2c:agronomy-pack:1.0.0",
  "title": "KISANAI regional agronomy pack",
  "description": "Shareable regional data model: crop calendars, groundwater context, district profiles and regulations for one state/province. Contains no farmer data. Crops are keyed by the global crop catalog id and scientific name so nodes in different countries can exchange packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "region",
    "license",
    "review",
    "sources",
    "seasons",
    "groundwater",
    "crops"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^pack_[a-z]{2}_[a-z0-9_]{2,40}$"
    },
    "pack_version": {
      "type": "integer",
      "minimum": 1
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "subdivision_code",
        "name"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "subdivision_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
          "description": "ISO 3166-2 code"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "agro_climatic_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "organization_label"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "organization_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "license": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "curated_pending_review",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "months"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]{2,20}$"
          },
          "months": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "groundwater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "scope"
      ],
      "properties": {
        "category": {
          "enum": [
            "safe",
            "semi_critical",
            "critical",
            "over_exploited",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "state",
            "district"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 600
        },
        "source": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crop_id",
          "scientific_name",
          "sowing_windows"
        ],
        "properties": {
          "crop_id": {
            "type": "string",
            "pattern": "^[a-z_]{2,40}$"
          },
          "scientific_name": {
            "type": "string",
            "maxLength": 120
          },
          "sowing_windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "season",
                "start",
                "end",
                "irrigation_required"
              ],
              "properties": {
                "season": {
                  "type": "string",
                  "pattern": "^[a-z_]{2,20}$"
                },
                "start": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                },
                "irrigation_required": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "subdivision": {
            "type": "string",
            "maxLength": 120
          },
          "agro_climatic_zone": {
            "type": "string",
            "maxLength": 160
          },
          "normal_rainfall_mm": {
            "type": "number",
            "minimum": 0
          },
          "monsoon_normal_mm": {
            "type": "number",
            "minimum": 0
          },
          "predominant_soil": {
            "type": "string",
            "maxLength": 40
          },
          "groundwater_category": {
            "enum": [
              "safe",
              "semi_critical",
              "critical",
              "over_exploited",
              "unknown"
            ]
          },
          "primary_crops": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]{2,40}$"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 600
          },
          "region_note": {
            "type": "string",
            "maxLength": 300
          },
          "sowing_overrides": {
            "type": "array",
            "description": "District-specific windows that replace the pack's windows for a crop (e.g. legal sowing dates by region).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "crop_id",
                "sowing_windows"
              ],
              "properties": {
                "crop_id": {
                  "type": "string",
                  "pattern": "^[a-z_]{2,40}$"
                },
                "sowing_windows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "season",
                      "start",
                      "end",
                      "irrigation_required"
                    ],
                    "properties": {
                      "season": {
                        "type": "string",
                        "pattern": "^[a-z_]{2,20}$"
                      },
                      "start": {
                        "type": "string",
                        "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                      },
                      "irrigation_required": {
                        "type": "boolean"
                      },
                      "label": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            }
          }
        }
      }
    },
    "priority_practices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z-]{3,60}$"
      }
    },
    "regulations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crop_id",
          "earliest_sowing",
          "text"
        ],
        "properties": {
          "crop_id": {
            "type": "string"
          },
          "earliest_sowing": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          },
          "text": {
            "type": "string",
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
